####    Convertidor de Mayusculas a minusculas
###     Silla - silla

def AMinusculas(texto): 
    letras =''
    for letra in texto:
        if ord(letra) >= 65 and ord(letra) <=90:
            letra = chr(ord(letra) +32)
        letras += letra
    return letras




